# TRAIL Environment Configuration

# Frontend App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# ─── AI Integration ────────────────────────────────────────────────────────────
# TRAIL Scout uses Google Gemini for natural language spot discovery.
# Recommended model: gemini-1.5-pro (or gemini-2.0-flash / gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-pro

# Get your free API key at: https://aistudio.google.com/app/apikey
# Note: You can either set GEMINI_API_KEY in backend/.env or enter it directly
# via the "AI Settings" gear button in the web UI chatbot on any machine!
GEMINI_API_KEY=

