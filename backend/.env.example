# TRAIL Backend — Environment Variables

# Server Port
PORT=4000

# CORS — allow your frontend origin
FRONTEND_URL=http://localhost:3000

# ─── AI Integration ────────────────────────────────────────────────────────────
# TRAIL Scout uses Google Gemini for natural language spot discovery.
#
# Recommended models:
#   gemini-1.5-pro   (Strongest reasoning & rich local nuances — DEFAULT)
#   gemini-2.0-flash (Ultra-fast, next-generation)
#   gemini-1.5-flash (Lightweight & efficient)
GEMINI_MODEL=gemini-1.5-pro

# Get your free API key at: https://aistudio.google.com/app/apikey
# If this key is NOT set in .env, users can also paste their key directly into
# the Web UI Settings, or the server will gracefully use the built-in local knowledge engine.
GEMINI_API_KEY=

